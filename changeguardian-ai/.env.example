# ============================================================
# ChangeGuardian AI — Environment Variables
#
# Copy to .env and fill in your real values.
# The config loader resolves ${VAR_NAME} placeholders
# in config/config.yaml from these variables.
# ============================================================

# --- LLM (required) ------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini

# For Qwen or any other OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://your-endpoint/v1
OPENAI_BASE_URL=

# --- Neo4j (required) ----------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Pinecone (optional — only when vector_store.type=pinecone) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=changeguardian

# --- API server -----------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Logging --------------------------------------------------
LOG_LEVEL=INFO
